# LedgerLab Backend Server Environment Configuration (Template Only)
# Copy to backend/.env locally or configure via Google Cloud Run Secret Manager.
# NEVER commit real credentials or database URLs to Git.

NODE_ENV=development
PORT=3000

# Authoritative PostgreSQL connection string
DATABASE_URL=postgresql://postgres:replace_with_password@localhost:5432/ledgerlab

# Session & CSRF secrets (generate 32+ random bytes via: openssl rand -hex 32)
SESSION_SECRET=replace_with_64_char_hex_session_secret
CSRF_SECRET=replace_with_64_char_hex_csrf_secret

# Webhook outbox signing master key
WEBHOOK_SIGNING_MASTER_KEY=replace_with_64_char_hex_webhook_key

# Strict CORS allowed origin
CORS_ORIGIN=http://localhost:5173
